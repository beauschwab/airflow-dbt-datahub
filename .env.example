# ============================================================
# Environment Variables (.env.example)
# ============================================================
# Copy to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# DataHub
DATAHUB_API_TOKEN=your-datahub-api-token-here
DATAHUB_GMS_URL=http://datahub-gms:8080

# Qualytics (optional)
QUALYTICS_API_URL=https://demo.qualytics.io/api
QUALYTICS_API_TOKEN=your-qualytics-api-token-here
QUALYTICS_DATASTORE_NAME=your-qualytics-datastore-name
QUALYTICS_CONTAINER_NAMES=nessie.marts.mart_positions,nessie.marts.mart_liquidity_risk,nessie.marts.mart_cashflow_forecast
QUALYTICS_INCREMENTAL_SCAN=true
QUALYTICS_REQUEST_TIMEOUT_SECONDS=30
QUALYTICS_POLL_INTERVAL_SECONDS=10
QUALYTICS_POLL_TIMEOUT_SECONDS=900

# dbt Spark connection (for local dev)
DBT_SPARK_HOST=localhost
DBT_SPARK_USER=spark

# AWS (for Iceberg / S3)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_DEFAULT_REGION=us-east-1
